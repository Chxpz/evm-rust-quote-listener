# Example .env file for WebSocket endpoints

# Ethereum network WebSocket URL
ETHEREUM_WEBSOCKET=wss://shape-mainnet.g.alchemy.com/v2/YOUR_ETHEREUM_API_KEY

# Base network WebSocket URL
BASE_WEBSOCKET=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_BASE_API_KEY

# Sonic network WebSocket URL
SONIC_WEBSOCKET=wss://sonic-mainnet.example.com/ws
